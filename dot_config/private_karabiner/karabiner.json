{
  "profiles": [
    {
      "complex_modifications": {
        "rules": [
          {
            "description": "右コマンドキーを、英数・かなのトグルに変更する（ひらがな入力中なら英数キー、それ以外ならかなキーを送る。日本語の入力ソースは select_input_source で選ぶと Google日本語入力の内部モードが追従しないため使わない。英字は ABC ではなく Google の英数（Roman）を使い、かなキーが Google 内で完結するようにしている）",
            "manipulators": [
              {
                "conditions": [
                  {
                    "input_sources": [
                      { "input_source_id": "^com\\.google\\.inputmethod\\.Japanese\\.base$" },
                      { "input_source_id": "^com\\.apple\\.inputmethod\\.Kotoeri\\.RomajiTyping\\.Japanese$" }
                    ],
                    "type": "input_source_if"
                  }
                ],
                "from": {
                  "key_code": "right_command",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [{ "key_code": "japanese_eisuu" }],
                "type": "basic"
              },
              {
                "from": {
                  "key_code": "right_command",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [{ "key_code": "japanese_kana" }],
                "type": "basic"
              }
            ]
          },
          {
            "description": "Caps Lock to Control",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": {
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "left_control"
                  }
                ]
              }
            ]
          },
          {
            "description": "escキーを押したときに、英数キーも送信する（vim用）",
            "manipulators": [
              {
                "from": { "key_code": "escape" },
                "to": [{ "key_code": "escape" }, { "key_code": "japanese_eisuu" }],
                "type": "basic"
              }
            ]
          },
          {
            "description": "Control + a を押したときに、英数キーも送信する（tmux用）",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "a",
                  "modifiers": {
                    "mandatory": ["control"]
                  }
                },
                "to": [
                  { "key_code": "japanese_eisuu" },
                  { "key_code": "a", "modifiers": ["control"] }
                ]
              }
            ]
          },
          {
            "description": "Control + j/k to move cursor up and down",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "j",
                  "modifiers": {
                    "mandatory": ["control"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "down_arrow"
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "k",
                  "modifiers": {
                    "mandatory": ["control"],
                    "optional": ["any"]
                  }
                },
                "to": [
                  {
                    "key_code": "up_arrow"
                  }
                ]
              }
            ]
          }
        ]
      },
      "name": "Default profile",
      "selected": true,
      "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
    }
  ]
}
