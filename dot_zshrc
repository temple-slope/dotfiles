# herdr 外のシェルなら herdr に入る（SSH 接続時に herdr が無い環境は tmux）
# herdr のサーバーは常駐するため、端末や SSH が切れても作業は止まらず、再接続で同じ画面に戻る
# 設定読み込みより前に exec し、二重初期化と抜けた後の外側シェル残留を防ぐ
if [[ -z "$HERDR_ENV" && -z "$TMUX" ]] && [ -t 1 ]; then
  if command -v herdr >/dev/null 2>&1; then
    exec herdr
  elif [[ -n "$SSH_CONNECTION" ]] && command -v tmux >/dev/null 2>&1; then
    exec tmux new-session -A -s default
  fi
fi

# PATH の重複を排除（入れ子シェルで path.zsh 等が再追加しても増えない）
typeset -U path PATH

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

eval "$(sheldon source)"

# Load Zsh configuration files from ~/.config/zsh
# All personal Zsh settings (env, alias, functions, plugins) are organized there.
for config_file in "$HOME/.config/zsh/"*.zsh; do
  source "$config_file"
done

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# CF CLI completions
[[ -f "$HOME/.config/cf/completions/_cf.zsh" ]] && source "$HOME/.config/cf/completions/_cf.zsh"
